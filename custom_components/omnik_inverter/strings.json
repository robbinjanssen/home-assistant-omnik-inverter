{
  "config": {
    "step": {
      "setup": {
        "title": "Omnik Inverter - JS or JSON",
        "description": "Set up Omnik Inverter to integrate with Home Assistant.",
        "data": {
          "name": "[%key:common::config_flow::data::name%]",
          "host": "[%key:common::config_flow::data::host%]"
        }
      },
      "setup_html": {
        "title": "Omnik Inverter - HTML",
        "description": "Set up Omnik Inverter to integrate with Home Assistant.",
        "data": {
          "name": "[%key:common::config_flow::data::name%]",
          "host": "[%key:common::config_flow::data::host%]",
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      },
      "setup_tcp": {
        "title": "Omnik Inverter - TCP",
        "description": "Set up Omnik Inverter to integrate with Home Assistant.",
        "data": {
          "name": "[%key:common::config_flow::data::name%]",
          "host": "[%key:common::config_flow::data::host%]",
          "serial": "Serial Number"
        }
      },
      "user": {
        "description": "Choose which data source applies to your Omnik Inverter.",
        "data": {
          "type": "Data source type"
        }
      },
      "reconfigure": {
        "title": "Reconfigure Omnik Inverter",
        "description": "Update the connection settings of your Omnik Inverter.",
        "data": {
          "host": "[%key:common::config_flow::data::host%]",
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]",
          "serial": "Serial Number"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "invalid_host": "[%key:common::config_flow::error::invalid_host%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reconfigure_successful": "[%key:common::config_flow::abort::reconfigure_successful%]",
      "wrong_device": "This is a different inverter than the one that was configured"
    }
  },
  "options": {
    "step": {
      "init": {
        "description": "Change how often the integration fetches your Omnik Inverter.",
        "data": {
          "scan_interval": "Minimum time between entity updates [m]"
        }
      }
    }
  },
  "entity": {
    "binary_sensor": {
      "online": {
        "name": "Online"
      }
    },
    "sensor": {
      "signal_quality": {
        "name": "Signal quality"
      },
      "ip_address": {
        "name": "IP address"
      },
      "solar_current_power": {
        "name": "Current power production"
      },
      "solar_energy_today": {
        "name": "Solar production today"
      },
      "solar_energy_total": {
        "name": "Solar production total"
      },
      "solar_hours_total": {
        "name": "Uptime"
      },
      "temperature": {
        "name": "Temperature"
      },
      "alarm_code": {
        "name": "Alarm code"
      },
      "dc_input_voltage": {
        "name": "DC input {index} voltage"
      },
      "dc_input_current": {
        "name": "DC input {index} current"
      },
      "ac_output_voltage": {
        "name": "AC output {index} voltage"
      },
      "ac_output_current": {
        "name": "AC output {index} current"
      },
      "ac_output_power": {
        "name": "AC output {index} power"
      },
      "ac_output_frequency": {
        "name": "AC output {index} frequency"
      }
    }
  },
  "device": {
    "wifi_module": {
      "name": "Wi-Fi module"
    }
  },
  "exceptions": {
    "migration_not_supported": {
      "message": "Config entry version {version} cannot be migrated. Please remove the integration and add it again."
    }
